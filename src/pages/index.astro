---
/**
 * Home Page
 * Premium editorial homepage with magazine-style layout
 * Clean, minimal, elegant design
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RecipeCard from '../components/RecipeCard.astro';

// Fetch all recipes
const allRecipes = await getCollection('recipes');

// Sort by date (newest first)
const sortedRecipes = allRecipes.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Get featured recipe
const featuredRecipe = sortedRecipes.find(recipe => recipe.data.featured) || sortedRecipes[0];

// Get latest recipes (excluding featured)
const latestRecipes = sortedRecipes
  .filter(recipe => recipe.id !== featuredRecipe?.id)
  .slice(0, 6);

// Categories (hardcoded for now, can be dynamic later)
const categories = [
  { name: 'Appetizers', icon: '🥟', slug: 'appetizers' },
  { name: 'Main Course', icon: '🍛', slug: 'main-course' },
  { name: 'Desserts', icon: '🍰', slug: 'desserts' },
  { name: 'Beverages', icon: '🍹', slug: 'beverages' },
];

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Kurry Twist - Authentic Indian Recipes"
  description="Discover authentic Indian recipes with a modern twist. From traditional curries to innovative fusion dishes, explore our collection of carefully crafted recipes."
>
  <!-- Hero Section -->
  <Hero
    title="Discover the Art of Indian Cooking"
    subtitle="Authentic recipes, modern techniques, timeless flavors"
    backgroundImage={`${base}images/hero-banner.jpg`}
    ctaText="Explore Recipes"
    ctaLink={`${base}recipes`}
    height="large"
  />

  <!-- Featured Recipe Section -->
  {featuredRecipe && (
    <section class="py-20 md:py-28 bg-cream-50">
      <div class="container mx-auto px-4">
        <div class="max-w-7xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            <!-- Image -->
            <div class="order-2 lg:order-1">
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={featuredRecipe.data.image}
                  alt={featuredRecipe.data.title}
                  class="w-full h-full object-cover"
                  onerror={`this.onerror=null; this.src='${base}images/placeholder.jpg';`}
                />
              </div>
            </div>

            <!-- Content -->
            <div class="order-1 lg:order-2">
              <p class="text-sm font-sans uppercase tracking-widest text-terracotta-500 mb-4">
                Featured Recipe
              </p>
              <h2 class="text-4xl md:text-5xl font-serif font-bold text-charcoal-700 mb-6 leading-tight">
                {featuredRecipe.data.title}
              </h2>
              <p class="text-charcoal-500 text-lg mb-8 leading-relaxed">
                {featuredRecipe.data.description}
              </p>

              <!-- Metadata -->
              <div class="flex flex-wrap gap-6 mb-8 text-sm text-charcoal-500 font-sans">
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span>{featuredRecipe.data.prepTime} prep</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path>
                  </svg>
                  <span>{featuredRecipe.data.cookTime} cook</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                  <span>{featuredRecipe.data.servings} servings</span>
                </div>
              </div>

              <a
                href={`${base}recipes/${featuredRecipe.id}`}
                class="inline-block bg-terracotta-500 text-white font-sans font-semibold text-sm uppercase tracking-wider px-8 py-4 hover:bg-terracotta-600 transition-colors"
              >
                View Recipe
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Latest Recipes Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-7xl mx-auto">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <p class="text-sm font-sans uppercase tracking-widest text-terracotta-500 mb-3">
            Fresh from the kitchen
          </p>
          <h2 class="text-4xl md:text-5xl font-serif font-bold text-charcoal-700 mb-4">
            Latest Recipes
          </h2>
          <p class="text-charcoal-500 text-lg max-w-2xl mx-auto">
            Discover our newest creations, crafted with love and tradition
          </p>
        </div>

        <!-- Recipe Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
          {latestRecipes.map((recipe) => (
            <RecipeCard
              title={recipe.data.title}
              slug={recipe.id}
              description={recipe.data.description}
              category={recipe.data.category}
              image={recipe.data.image}
              prepTime={recipe.data.prepTime}
              cookTime={recipe.data.cookTime}
              difficulty={recipe.data.difficulty}
              featured={recipe.data.featured}
              date={recipe.data.date}
              rating={recipe.data.rating}
              reviewCount={recipe.data.reviewCount}
            />
          ))}
        </div>

        <!-- View All Button -->
        <div class="text-center mt-16">
          <a
            href={`${base}recipes`}
            class="inline-block border-2 border-charcoal-700 text-charcoal-700 font-sans font-semibold text-sm uppercase tracking-wider px-8 py-4 hover:bg-charcoal-700 hover:text-cream-50 transition-colors"
          >
            View All Recipes
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="py-20 md:py-28 bg-cream-50">
    <div class="container mx-auto px-4">
      <div class="max-w-7xl mx-auto">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <p class="text-sm font-sans uppercase tracking-widest text-terracotta-500 mb-3">
            Explore by category
          </p>
          <h2 class="text-4xl md:text-5xl font-serif font-bold text-charcoal-700">
            Recipe Collections
          </h2>
        </div>

        <!-- Categories Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {categories.map((category) => (
            <a
              href={`${base}recipes#${category.slug}`}
              class="group bg-white p-8 text-center hover:shadow-lg transition-shadow"
            >
              <div class="text-5xl mb-4">{category.icon}</div>
              <h3 class="text-lg font-serif font-semibold text-charcoal-700 group-hover:text-terracotta-500 transition-colors">
                {category.name}
              </h3>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="py-20 md:py-28 bg-sage-50">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-charcoal-700 mb-4">
          Never Miss a Recipe
        </h2>
        <p class="text-charcoal-500 text-lg mb-8">
          Join our community and get new recipes delivered to your inbox
        </p>
        <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
          <input
            type="email"
            placeholder="Your email address"
            class="flex-1 px-6 py-4 border border-cream-400 bg-white focus:outline-none focus:border-terracotta-500 text-charcoal-700"
            required
          />
          <button
            type="submit"
            class="px-8 py-4 bg-terracotta-500 text-white font-sans font-semibold text-sm uppercase tracking-wider hover:bg-terracotta-600 transition-colors whitespace-nowrap"
          >
            Subscribe
          </button>
        </form>
        <p class="text-xs text-charcoal-400 mt-4">
          We respect your privacy. Unsubscribe anytime.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>



