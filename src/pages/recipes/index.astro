---
/**
 * Recipes Listing Page
 * Premium editorial recipe listing with clean filters
 * Magazine-style grid layout
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';

// Fetch all recipes
const allRecipes = await getCollection('recipes');

// Sort by date (newest first)
const sortedRecipes = allRecipes.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Get unique categories
const categories = [...new Set(allRecipes.map(recipe => recipe.data.category))];
---

<BaseLayout
  title="All Recipes - Kurry Twist"
  description="Browse our complete collection of authentic Indian recipes. From appetizers to desserts, find your next favorite dish."
>
  <!-- Header Section -->
  <section class="bg-cream-50 py-20 md:py-28 border-b border-cream-400">
    <div class="container mx-auto px-4 text-center">
      <p class="text-sm font-sans uppercase tracking-widest text-terracotta-500 mb-3">
        Our collection
      </p>
      <h1 class="text-5xl md:text-6xl font-serif font-bold text-charcoal-700 mb-6">
        All Recipes
      </h1>
      <p class="text-lg text-charcoal-500 max-w-2xl mx-auto">
        Explore our complete collection of {sortedRecipes.length} carefully crafted recipes
      </p>
    </div>
  </section>

  <!-- Filter Section (Placeholder) -->
  <section class="bg-white border-b border-cream-400 py-6 sticky top-20 z-40">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 max-w-7xl mx-auto">
        <!-- Categories Filter Placeholder -->
        <div class="flex flex-wrap items-center gap-3">
          <span class="text-xs font-sans uppercase tracking-wider text-charcoal-600 font-semibold">Filter:</span>
          <button class="px-4 py-2 bg-terracotta-500 text-white text-xs font-sans font-semibold uppercase tracking-wider transition-colors">
            All
          </button>
          {categories.map((category) => (
            <button class="px-4 py-2 bg-cream-200 text-charcoal-600 text-xs font-sans font-semibold uppercase tracking-wider hover:bg-cream-300 transition-colors">
              {category}
            </button>
          ))}
        </div>

        <!-- Sort Placeholder -->
        <div class="flex items-center gap-3">
          <span class="text-xs font-sans uppercase tracking-wider text-charcoal-600 font-semibold">Sort:</span>
          <select class="px-4 py-2 border border-cream-400 text-xs font-sans uppercase tracking-wider text-charcoal-600 bg-white hover:border-terracotta-500 focus:outline-none focus:border-terracotta-500">
            <option>Newest First</option>
            <option>Oldest First</option>
            <option>A-Z</option>
            <option>Z-A</option>
          </select>
        </div>
      </div>
    </div>
  </section>

  <!-- Recipes Grid -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-7xl mx-auto">
        {sortedRecipes.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
            {sortedRecipes.map((recipe) => (
              <RecipeCard
                title={recipe.data.title}
                slug={recipe.id}
                description={recipe.data.description}
                category={recipe.data.category}
                image={recipe.data.image}
                prepTime={recipe.data.prepTime}
                cookTime={recipe.data.cookTime}
                difficulty={recipe.data.difficulty}
                featured={recipe.data.featured}
                date={recipe.data.date}
                rating={recipe.data.rating}
                reviewCount={recipe.data.reviewCount}
              />
            ))}
          </div>
        ) : (
          <div class="text-center py-16">
            <p class="text-charcoal-400 text-lg">No recipes found. Check back soon!</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-20 md:py-28 bg-sage-50">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-charcoal-700 mb-4">
          Stay Updated
        </h2>
        <p class="text-charcoal-500 text-lg mb-8">
          Get new recipes delivered straight to your inbox
        </p>
        <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
          <input
            type="email"
            placeholder="Your email address"
            class="flex-1 px-6 py-4 border border-cream-400 bg-white focus:outline-none focus:border-terracotta-500 text-charcoal-700"
            required
          />
          <button
            type="submit"
            class="px-8 py-4 bg-terracotta-500 text-white font-sans font-semibold text-sm uppercase tracking-wider hover:bg-terracotta-600 transition-colors whitespace-nowrap"
          >
            Subscribe
          </button>
        </form>
        <p class="text-xs text-charcoal-400 mt-4">
          We respect your privacy. Unsubscribe anytime.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
