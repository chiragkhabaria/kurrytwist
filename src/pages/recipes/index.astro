---
/**
 * Recipes Listing Page
 * Displays all recipes in a responsive grid
 * Styled exclusively with Tailwind utilities
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';

// Fetch all recipes
const allRecipes = await getCollection('recipes');

// Sort by date (newest first)
const sortedRecipes = allRecipes.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Get unique categories
const categories = [...new Set(allRecipes.map(recipe => recipe.data.category))];
---

<BaseLayout
  title="All Recipes"
  description="Browse our complete collection of authentic Indian recipes. From appetizers to desserts, find your next favorite dish."
>
  <!-- Header Section -->
  <section class="bg-gradient-to-r from-primary-600 to-orange-600 py-12 md:py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        All Recipes
      </h1>
      <p class="text-lg md:text-xl text-white/95 max-w-2xl mx-auto">
        Explore our complete collection of {sortedRecipes.length} delicious recipes
      </p>
    </div>
  </section>

  <!-- Filter/Sort Section (Placeholder) -->
  <section class="bg-white border-b border-gray-200 py-4 md:py-6 sticky top-16 z-40">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <!-- Categories Filter Placeholder -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-sm font-semibold text-gray-700">Filter by:</span>
          <button class="px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-full hover:bg-primary-700 transition-colors">
            All
          </button>
          {categories.map((category) => (
            <button class="px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-full hover:bg-gray-200 transition-colors">
              {category}
            </button>
          ))}
        </div>

        <!-- Sort Placeholder -->
        <div class="flex items-center gap-2">
          <span class="text-sm font-semibold text-gray-700">Sort by:</span>
          <select class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:border-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500">
            <option>Newest First</option>
            <option>Oldest First</option>
            <option>A-Z</option>
            <option>Z-A</option>
          </select>
        </div>
      </div>
    </div>
  </section>

  <!-- Recipes Grid -->
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      {sortedRecipes.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 max-w-7xl mx-auto">
          {sortedRecipes.map((recipe) => (
            <RecipeCard
              title={recipe.data.title}
              slug={recipe.slug}
              description={recipe.data.description}
              category={recipe.data.category}
              image={recipe.data.image}
              prepTime={recipe.data.prepTime}
              cookTime={recipe.data.cookTime}
              difficulty={recipe.data.difficulty}
              featured={recipe.data.featured}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-gray-500 text-lg">No recipes found. Check back soon!</p>
        </div>
      )}
    </div>
  </section>

  <!-- Newsletter CTA (Optional) -->
  <section class="py-12 md:py-16 bg-orange-50">
    <div class="container mx-auto px-4 max-w-3xl text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
        Never Miss a Recipe
      </h2>
      <p class="text-gray-600 mb-6">
        Subscribe to get new recipes delivered straight to your inbox
      </p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <input
          type="email"
          placeholder="Your email address"
          class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
          required
        />
        <button
          type="submit"
          class="px-8 py-3 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors whitespace-nowrap"
        >
          Subscribe
        </button>
      </form>
      <p class="text-xs text-gray-500 mt-3">
        We respect your privacy. Unsubscribe at any time.
      </p>
    </div>
  </section>
</BaseLayout>
