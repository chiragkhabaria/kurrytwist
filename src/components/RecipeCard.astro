---
/**
 * RecipeCard Component
 * Premium editorial recipe card with image fallback
 * Clean, minimal, magazine-style design
 */
export interface Props {
  title: string;
  slug: string;
  description?: string;
  category: string;
  image: string;
  prepTime: string;
  cookTime: string;
  difficulty?: string;
  featured?: boolean;
}

const {
  title,
  slug,
  description,
  category,
  image,
  prepTime,
  cookTime,
  difficulty,
  featured = false
} = Astro.props;

// Image fallback
const fallbackImage = '/images/placeholder.jpg';
const imageUrl = image || fallbackImage;

const difficultyColors = {
  Easy: 'bg-sage-100 text-sage-700',
  Medium: 'bg-cream-400 text-charcoal-600',
  Hard: 'bg-terracotta-100 text-terracotta-700',
};

const difficultyColor = difficulty ? (difficultyColors[difficulty as keyof typeof difficultyColors] || 'bg-cream-300 text-charcoal-600') : 'bg-cream-300 text-charcoal-600';
---

<article class="group relative">
  <a href={`/recipes/${slug}`} class="block">
    <!-- Image -->
    <div class="relative w-full aspect-[4/3] overflow-hidden bg-cream-200 mb-4">
      <img
        src={imageUrl}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        loading="lazy"
        onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
      />
      {featured && (
        <div class="absolute top-4 right-4 bg-terracotta-500 text-white px-3 py-1 text-xs font-semibold uppercase tracking-wider">
          Featured
        </div>
      )}
    </div>

    <!-- Content -->
    <div>
      <!-- Category Badge -->
      <div class="mb-2">
        <span class="inline-block text-charcoal-500 text-xs font-sans uppercase tracking-widest">
          {category}
        </span>
      </div>

      <!-- Title -->
      <h3 class="text-2xl font-serif font-bold text-charcoal-700 mb-2 group-hover:text-terracotta-500 transition-colors line-clamp-2">
        {title}
      </h3>

      <!-- Description -->
      {description && (
        <p class="text-charcoal-500 text-sm leading-relaxed mb-4 line-clamp-2">
          {description}
        </p>
      )}

      <!-- Metadata -->
      <div class="flex flex-wrap items-center gap-4 text-xs text-charcoal-500 font-sans uppercase tracking-wide">
        <!-- Prep + Cook Time -->
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>{prepTime} + {cookTime}</span>
        </div>

        <!-- Difficulty -->
        {difficulty && (
          <div class={`px-2 py-0.5 rounded text-xs font-medium ${difficultyColor}`}>
            {difficulty}
          </div>
        )}
      </div>
    </div>
  </a>
</article>
