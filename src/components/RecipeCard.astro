---
/**
 * Recipe Card Component
 */
import StarRating from './StarRating.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  prepTime: string;
  cookTime: string;
  image: string;
  difficulty?: string;
  date: Date;
  rating?: number;
  reviewCount?: number;
}

const { 
  slug, 
  title, 
  description, 
  category, 
  prepTime, 
  cookTime, 
  image,
  difficulty,
  date,
  rating,
  reviewCount
} = Astro.props;

const base = import.meta.env.BASE_URL;
const fallbackImage = `${base}images/placeholder.jpg`;
// Strip leading slash from frontmatter image path and prepend base
const imageUrl = image ? `${base}${image.replace(/^\//, '')}` : fallbackImage;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});
---

<article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 hover:scale-[1.02]">
  <a href={`${base}recipes/${slug}`} class="block">
    <div class="relative aspect-[4/3] overflow-hidden">
      <img
        src={imageUrl}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
        loading="lazy"
        onerror={`this.onerror=null; this.src='${base}images/placeholder.jpg';`}
      />
      <div class="absolute top-4 left-4">
        <span class="px-3 py-1.5 bg-white text-xs uppercase tracking-wider text-charcoal-700 font-semibold rounded-full shadow-sm">
          {category}
        </span>
      </div>
    </div>
    
    <div class="p-6">
      <!-- Date and Category -->
      <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-terracotta-500 font-semibold mb-2">
        <span>{category}</span>
        <span>•</span>
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </div>

      <h3 class="text-2xl font-serif text-charcoal-800 mb-2 hover:text-terracotta-500 transition-colors">
        {title}
      </h3>
      
      <p class="text-charcoal-600 mb-4 line-clamp-2 leading-relaxed">
        {description}
      </p>

      <!-- Star Rating -->
      {rating && (
        <div class="mb-4">
          <StarRating rating={rating} reviewCount={reviewCount} size="sm" />
        </div>
      )}
      
      <div class="flex items-center gap-4 text-sm text-charcoal-600">
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{prepTime}</span>
        </div>
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
          </svg>
          <span>{cookTime}</span>
        </div>
        {difficulty && (
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>{difficulty}</span>
          </div>
        )}
      </div>
    </div>
  </a>
</article>
