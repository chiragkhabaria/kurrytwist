---
/**
 * Hero Component
 * Premium editorial hero section with elegant typography
 * Magazine-style layout
 */
export interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  ctaText?: string;
  ctaLink?: string;
  height?: 'small' | 'medium' | 'large';
}

const {
  title,
  subtitle,
  backgroundImage,
  ctaText,
  ctaLink,
  height = 'large'
} = Astro.props;

const heightClasses = {
  small: 'h-[40vh] min-h-[300px]',
  medium: 'h-[60vh] min-h-[400px]',
  large: 'h-[70vh] min-h-[500px]',
};

const heightClass = heightClasses[height];
const bgImage = backgroundImage || `${import.meta.env.BASE_URL}images/hero-banner.jpg`;
---

<section class={`relative ${heightClass} flex items-center justify-center overflow-hidden`}>
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0">
    <img
      src={bgImage}
      alt={title}
      class="w-full h-full object-cover"
      onerror={`this.onerror=null; this.src='${import.meta.env.BASE_URL}images/placeholder.jpg';`}
    />
    <div class="absolute inset-0 bg-charcoal-700/40"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container mx-auto px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-serif font-bold text-cream-50 mb-6 leading-tight">
        {title}
      </h1>
      {subtitle && (
        <p class="text-lg md:text-xl text-cream-100 mb-8 leading-relaxed max-w-2xl mx-auto">
          {subtitle}
        </p>
      )}
      {ctaText && ctaLink && (
        <a
          href={ctaLink}
          class="inline-block bg-terracotta-500 text-white font-sans font-semibold text-sm uppercase tracking-wider px-8 py-4 hover:bg-terracotta-600 transition-colors"
        >
          {ctaText}
        </a>
      )}
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-10">
    <svg class="w-6 h-6 text-cream-50 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>
