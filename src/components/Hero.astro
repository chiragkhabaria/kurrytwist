---
/**
 * Hero Component
 * Full-width hero banner with background image, overlay, and CTA
 * Styled exclusively with Tailwind utilities
 */
export interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  ctaText?: string;
  ctaLink?: string;
  height?: 'small' | 'medium' | 'large';
}

const {
  title,
  subtitle,
  backgroundImage = '/images/sample-recipe.jpg',
  ctaText = 'Explore Recipes',
  ctaLink = '/recipes',
  height = 'large'
} = Astro.props;

const heightClasses = {
  small: 'h-64 md:h-80',
  medium: 'h-80 md:h-96',
  large: 'h-96 md:h-[32rem]'
};
---

<section 
  class={`relative w-full ${heightClasses[height]} flex items-center justify-center overflow-hidden`}
  style={backgroundImage ? `background-image: url('${backgroundImage}'); background-size: cover; background-position: center;` : ''}
>
  <!-- Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-r from-primary-600/80 via-primary-500/70 to-orange-600/80"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 md:mb-6 leading-tight">
      {title}
    </h1>
    
    {subtitle && (
      <p class="text-lg md:text-xl lg:text-2xl text-white/95 mb-6 md:mb-8 max-w-2xl mx-auto">
        {subtitle}
      </p>
    )}

    {ctaText && ctaLink && (
      <a
        href={ctaLink}
        class="inline-block bg-white text-primary-600 font-semibold px-8 py-3 md:px-10 md:py-4 rounded-full hover:bg-orange-50 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1"
      >
        {ctaText}
      </a>
    )}
  </div>
</section>
