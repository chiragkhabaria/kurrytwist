---
/**
 * Header Component
 * Premium editorial navigation with sticky behavior
 */
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL; // '/kurrytwist/' in prod, '/' in dev
const isHome = currentPath === base || currentPath === base.replace(/\/$/, '');
const isRecipes = currentPath.startsWith(`${base}recipes`) || currentPath.startsWith('/recipes');
const isAbout = currentPath === `${base}about` || currentPath === '/about';
---

<header class="sticky top-0 z-50 bg-cream-50/95 backdrop-blur-sm border-b border-cream-400">
  <div class="container mx-auto px-4">
    <!-- Top bar with logo and main nav -->
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href={base} class="flex items-center space-x-2 group">
        <span class="text-3xl font-serif font-bold text-charcoal-700 tracking-tight group-hover:text-terracotta-500 transition-colors">
          Kurry <span class="text-terracotta-500">Twist</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-8">
        <a
          href={base}
          class={`text-sm uppercase tracking-wider font-sans transition-colors ${
            isHome
              ? 'text-charcoal-700 font-semibold border-b-2 border-terracotta-500' 
              : 'text-charcoal-500 hover:text-charcoal-700'
          }`}
        >
          Home
        </a>
        <a
          href={`${base}recipes`}
          class={`text-sm uppercase tracking-wider font-sans transition-colors ${
            isRecipes
              ? 'text-charcoal-700 font-semibold border-b-2 border-terracotta-500' 
              : 'text-charcoal-500 hover:text-charcoal-700'
          }`}
        >
          Recipes
        </a>
        <a
          href={`${base}about`}
          class={`text-sm uppercase tracking-wider font-sans transition-colors ${
            isAbout
              ? 'text-charcoal-700 font-semibold border-b-2 border-terracotta-500' 
              : 'text-charcoal-500 hover:text-charcoal-700'
          }`}
        >
          About
        </a>
      </nav>

      <!-- Search icon (placeholder) -->
      <button
        class="hidden md:block p-2 text-charcoal-500 hover:text-charcoal-700 transition-colors"
        aria-label="Search"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </button>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 text-charcoal-600 hover:text-charcoal-700 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-cream-400 bg-cream-50">
    <nav class="container mx-auto px-4 py-6 space-y-4">
      <a href={base} class={`block text-base uppercase tracking-wide font-sans transition-colors py-2 ${isHome ? 'text-charcoal-700 font-semibold' : 'text-charcoal-500'}`}>
        Home
      </a>
      <a href={`${base}recipes`} class={`block text-base uppercase tracking-wide font-sans transition-colors py-2 ${isRecipes ? 'text-charcoal-700 font-semibold' : 'text-charcoal-500'}`}>
        Recipes
      </a>
      <a href={`${base}about`} class={`block text-base uppercase tracking-wide font-sans transition-colors py-2 ${isAbout ? 'text-charcoal-700 font-semibold' : 'text-charcoal-500'}`}>
        About
      </a>
      <div class="pt-4 border-t border-cream-400">
        <button class="w-full text-left text-base text-charcoal-500 uppercase tracking-wide py-2">Search</button>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpenIcon = document.getElementById('menu-open-icon');
  const menuCloseIcon = document.getElementById('menu-close-icon');

  menuButton?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden');
    menuOpenIcon?.classList.toggle('hidden');
    menuCloseIcon?.classList.toggle('hidden');
    menuButton?.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
  });
</script>
