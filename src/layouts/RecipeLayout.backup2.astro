---
/**
 * RecipeLayout
 * Premium editorial layout for recipe detail pages
 * Magazine-style design with clean typography
 */
import BaseLayout from './BaseLayout.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';

export interface Props {
  title: string;
  description: string;
  image: string;
  category: string;
  prepTime: string;
  cookTime: string;
  servings: number;
  difficulty?: string;
  youtube?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  image,
  category,
  prepTime,
  cookTime,
  servings,
  difficulty,
  youtube,
  publishedTime,
  modifiedTime
} = Astro.props;

const fallbackImage = '/images/placeholder.jpg';
const imageUrl = image || fallbackImage;
---

<BaseLayout
  title={title}
  description={description}
  image={imageUrl}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>
  <!-- Hero Image -->
  <div class="w-full aspect-[16/9] md:aspect-[21/9] relative overflow-hidden bg-cream-200">
    <img
      src={imageUrl}
      alt={title}
      class="w-full h-full object-cover"
      onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal-700/60 to-transparent"></div>
    
    <!-- Title Overlay on Image -->
    <div class="absolute bottom-0 left-0 right-0 p-8 md:p-12 lg:p-16">
      <div class="container mx-auto max-w-5xl">
        <p class="text-xs md:text-sm font-sans uppercase tracking-widest text-cream-200 mb-3">
          {category}
        </p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-cream-50 leading-tight">
          {title}
        </h1>
      </div>
    </div>
  </div>

  <!-- Recipe Content -->
  <article class="bg-white">
    <div class="container mx-auto max-w-5xl px-4 py-12 md:py-16 lg:py-20">
      <!-- Recipe Meta -->
      <div class="mb-12 pb-8 border-b border-cream-400">
        <!-- Description -->
        <p class="text-lg md:text-xl text-charcoal-500 leading-relaxed mb-8">
          {description}
        </p>

        <!-- Metadata Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="text-center md:text-left">
            <p class="text-xs font-sans uppercase tracking-wider text-charcoal-400 mb-1">Prep Time</p>
            <p class="text-2xl font-serif font-bold text-charcoal-700">{prepTime}</p>
          </div>
          <div class="text-center md:text-left">
            <p class="text-xs font-sans uppercase tracking-wider text-charcoal-400 mb-1">Cook Time</p>
            <p class="text-2xl font-serif font-bold text-charcoal-700">{cookTime}</p>
          </div>
          <div class="text-center md:text-left">
            <p class="text-xs font-sans uppercase tracking-wider text-charcoal-400 mb-1">Servings</p>
            <p class="text-2xl font-serif font-bold text-charcoal-700">{servings}</p>
          </div>
          {difficulty && (
            <div class="text-center md:text-left">
              <p class="text-xs font-sans uppercase tracking-wider text-charcoal-400 mb-1">Difficulty</p>
              <p class="text-2xl font-serif font-bold text-charcoal-700">{difficulty}</p>
            </div>
          )}
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-4 mt-8">
          <button
            class="inline-flex items-center gap-2 px-6 py-3 bg-terracotta-500 text-white font-sans font-semibold text-sm uppercase tracking-wider hover:bg-terracotta-600 transition-colors"
            onclick="window.print()"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2-2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Print Recipe
          </button>
          <button
            class="inline-flex items-center gap-2 px-6 py-3 border-2 border-charcoal-700 text-charcoal-700 font-sans font-semibold text-sm uppercase tracking-wider hover:bg-charcoal-700 hover:text-cream-50 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
            </svg>
            Share
          </button>
        </div>
      </div>

      <!-- YouTube Video -->
      {youtube && (
        <div class="mb-12">
          <h2 class="text-2xl font-serif font-bold text-charcoal-700 mb-6">Watch How It's Made</h2>
          <YoutubeEmbed videoId={youtube} title={`${title} video`} />
        </div>
      )}

      <!-- Recipe Content: Single Column -->
      <div class="recipe-content max-w-reading">
        <slot />
      </div>

      <!-- Share Section -->
      <div class="mt-16 pt-8 border-t border-cream-400 text-center">
        <p class="text-sm font-sans uppercase tracking-wider text-charcoal-500 mb-4">Share this recipe</p>
        <div class="flex justify-center gap-4">
          <a href="#" class="p-3 text-charcoal-400 hover:text-terracotta-500 transition-colors" aria-label="Share on Facebook">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
            </svg>
          </a>
          <a href="#" class="p-3 text-charcoal-400 hover:text-terracotta-500 transition-colors" aria-label="Share on Pinterest">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
            </svg>
          </a>
          <a href="#" class="p-3 text-charcoal-400 hover:text-terracotta-500 transition-colors" aria-label="Share on Twitter">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Recipes Placeholder -->
    <section class="bg-cream-50 py-16">
      <div class="container mx-auto max-w-5xl px-4">
        <h2 class="text-3xl font-serif font-bold text-charcoal-700 mb-8 text-center">
          You Might Also Like
        </h2>
        <p class="text-center text-charcoal-400 italic">Related recipes coming soon...</p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  /* Recipe content styling */
  .recipe-content {
    color: var(--color-charcoal-600);
  }
  
  .recipe-content h2 {
    font-size: 1.875rem;
    font-family: var(--font-family-serif);
    font-weight: bold;
    color: var(--color-charcoal-700);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }
  
  .recipe-content h2:first-child {
    margin-top: 0;
  }
  
  .recipe-content h3 {
    font-size: 1.25rem;
    font-family: var(--font-family-serif);
    font-weight: 600;
    color: var(--color-charcoal-700);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  .recipe-content ul {
    margin-bottom: 2rem;
  }
  
  .recipe-content ol {
    margin-bottom: 2rem;
  }
  
  .recipe-content li {
    color: var(--color-charcoal-600);
    line-height: 1.625;
    padding-left: 0.5rem;
    margin-bottom: 0.75rem;
  }
  
  .recipe-content ul li {
    position: relative;
    padding-left: 1.5rem;
  }
  
  .recipe-content ul li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-terracotta-500);
    font-weight: bold;
  }
  
  .recipe-content ol {
    counter-reset: step-counter;
  }
  
  .recipe-content ol li {
    position: relative;
    padding-left: 2rem;
    counter-increment: step-counter;
  }
  
  .recipe-content ol li::before {
    content: counter(step-counter);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-terracotta-500);
    color: white;
    font-size: 0.875rem;
    font-weight: bold;
    border-radius: 9999px;
  }
  
  .recipe-content p {
    margin-bottom: 1.5rem;
    line-height: 1.625;
    font-size: 1.125rem;
  }
  
  .recipe-content strong {
    font-weight: 600;
    color: var(--color-charcoal-700);
  }

  /* Print styles */
  @media print {
    header nav,
    footer,
    button,
    .no-print {
      display: none;
    }
  }
</style>
