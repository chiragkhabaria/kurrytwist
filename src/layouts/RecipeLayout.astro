---
/**
 * Recipe Layout - Cucinetta-inspired design
 * Recipe info card injected into Ingredients section
 * Ingredient quantities scale with serving size
 */
import BaseLayout from './BaseLayout.astro';
import StarRating from '../components/StarRating.astro';
import TableOfContents from '../components/TableOfContents.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  prepTime: string;
  cookTime: string;
  servings: number;
  difficulty?: string;
  image: string;
  youtube?: string;
  date: Date;
  rating?: number;
  reviewCount?: number;
}

const {
  title,
  description,
  category,
  prepTime,
  cookTime,
  servings,
  difficulty,
  image,
  youtube,
  date,
  rating,
  reviewCount
} = Astro.props;

const base = import.meta.env.BASE_URL;
const fallbackImage = `${base}images/placeholder.jpg`;
// Strip leading slash from frontmatter image path and prepend base
const imageUrl = image ? `${base}${image.replace(/^\//, '')}` : fallbackImage;

// Format date
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});

// Calculate total time
const prepMinutes = parseInt(prepTime.match(/\d+/)?.[0] || '0');
const cookMinutes = parseInt(cookTime.match(/\d+/)?.[0] || '0');
const totalMinutes = prepMinutes + cookMinutes;
---

<BaseLayout title={title} description={description}>
  <!-- Header with breadcrumb and title -->
  <div class="bg-white border-b border-sage-100 py-8">
    <div class="container mx-auto px-4 max-w-5xl">
      <!-- Breadcrumb -->
      <div class="mb-4">
        <a href={import.meta.env.BASE_URL} class="text-terracotta-500 text-xs uppercase tracking-wider hover:text-terracotta-600">
          ← All recipes
        </a>
      </div>
      
      <!-- Category Badge -->
      <div class="mb-3">
        <span class="text-xs uppercase tracking-widest text-terracotta-500 font-semibold">
          {category}
        </span>
      </div>
      
      <!-- Title -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-charcoal-800 mb-4 leading-tight">
        {title}
      </h1>
      
      <!-- Description -->
      <p class="text-lg text-charcoal-600 mb-6 max-w-3xl leading-relaxed">
        {description}
      </p>
      
      <!-- Metadata Row -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-charcoal-600">
        <span>By Elena March</span>
        <span>•</span>
        <time datetime={date.toISOString()}>
          {formattedDate}
        </time>
        {rating && (
          <>
            <span>•</span>
            <StarRating rating={rating} reviewCount={reviewCount} size="sm" />
          </>
        )}
        {difficulty && (
          <>
            <span>•</span>
            <span>{difficulty}</span>
          </>
        )}
      </div>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="w-full bg-white">
    <div class="container mx-auto px-4 max-w-5xl py-8">
      <div class="relative w-full aspect-[16/10] rounded-2xl overflow-hidden">
        <img
          src={imageUrl}
          alt={title}
          class="w-full h-full object-cover"
          onerror={`this.onerror=null; this.src='${import.meta.env.BASE_URL}images/placeholder.jpg';`}
        />
        <button class="absolute bottom-4 right-4 px-4 py-2 bg-white hover:bg-cream-50 text-charcoal-700 rounded-lg shadow-md text-sm font-medium flex items-center gap-2 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
          Pin this
        </button>
      </div>
      <p class="text-xs text-charcoal-500 mt-2">
        Photo by <a href="#" class="text-terracotta-500 hover:underline">Eaters Collective</a> on Unsplash
      </p>
    </div>
  </div>

  <!-- Main Content Area -->
  <div class="bg-cream-50 py-12">
    <div class="container mx-auto px-4">
      <div class="max-w-7xl mx-auto">
        <div class="flex gap-8 lg:gap-12">
          <!-- Left Sidebar: Table of Contents -->
          <TableOfContents />

          <!-- Main Content -->
          <div class="flex-1 max-w-3xl">
            <!-- Hidden Recipe Info Card - moved by JS to sit after "Ingredients" heading -->
            <div id="recipe-info-card" class="hidden mb-6">
              <div class="bg-cream-100 border border-sage-200 rounded-2xl px-6 py-5 grid grid-cols-3 divide-x divide-sage-200">
                <!-- Total Time -->
                <div class="pr-6">
                  <p class="text-[10px] uppercase tracking-widest text-charcoal-500 font-semibold mb-1">Total Time</p>
                  <div class="flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-charcoal-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-base font-semibold text-charcoal-800">{totalMinutes} min</span>
                  </div>
                </div>

                <!-- Prep + Cook -->
                <div class="px-6">
                  <p class="text-[10px] uppercase tracking-widest text-charcoal-500 font-semibold mb-1">Prep + Cook</p>
                  <div class="flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-charcoal-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-base font-semibold text-charcoal-800">{prepMinutes}m + {cookMinutes}m</span>
                  </div>
                </div>

                <!-- Yield with inline adjuster -->
                <div class="pl-6">
                  <p class="text-[10px] uppercase tracking-widest text-charcoal-500 font-semibold mb-1">Yield</p>
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-charcoal-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span id="serving-count" class="text-base font-semibold text-charcoal-800">{servings}</span>
                    <span class="text-sm text-charcoal-600">servings</span>
                    <button
                      id="decrease-servings"
                      class="w-6 h-6 flex items-center justify-center text-charcoal-500 hover:text-charcoal-800 transition-colors text-lg leading-none font-light"
                      aria-label="Decrease servings"
                    >—</button>
                    <button
                      id="increase-servings"
                      class="w-6 h-6 flex items-center justify-center text-charcoal-500 hover:text-charcoal-800 transition-colors text-lg leading-none font-light"
                      aria-label="Increase servings"
                    >+</button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Main Recipe Content -->
            <div class="recipe-content bg-white rounded-2xl shadow-sm p-8 md:p-10">
              <slot />
            </div>

            <!-- YouTube Video -->
            {youtube && (
              <div class="mt-8 bg-white rounded-2xl shadow-sm p-8">
                <h2 class="text-2xl font-serif font-bold text-charcoal-800 mb-6">
                  Watch the Video
                </h2>
                <YoutubeEmbed videoId={youtube} title={title} />
              </div>
            )}

            <!-- Share Section -->
            <div class="mt-8 bg-white rounded-2xl shadow-sm p-8">
              <h3 class="text-lg font-serif font-bold text-charcoal-800 mb-4">
                Share this recipe
              </h3>
              <div class="flex flex-wrap gap-3">
                <button class="flex items-center gap-2 px-4 py-2 bg-cream-100 hover:bg-cream-200 text-charcoal-700 rounded-lg transition-colors text-sm font-medium">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                  Facebook
                </button>
                <button class="flex items-center gap-2 px-4 py-2 bg-cream-100 hover:bg-cream-200 text-charcoal-700 rounded-lg transition-colors text-sm font-medium">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                  </svg>
                  Twitter
                </button>
                <button class="flex items-center gap-2 px-4 py-2 bg-cream-100 hover:bg-cream-200 text-charcoal-700 rounded-lg transition-colors text-sm font-medium">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                  </svg>
                  Copy Link
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Recipe Content Styling */
  .recipe-content {
    font-family: var(--font-family-sans);
    color: var(--color-charcoal-700);
    line-height: 1.75;
  }

  /* Main Headings (# in markdown) */
  .recipe-content :global(h1) {
    font-family: var(--font-family-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-charcoal-800);
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-sage-200);
    scroll-margin-top: 100px;
  }

  .recipe-content :global(h1:first-child) {
    margin-top: 0;
  }

  /* Sub-headings */
  .recipe-content :global(h2) {
    font-family: var(--font-family-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-charcoal-700);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .recipe-content :global(h3) {
    font-family: var(--font-family-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-charcoal-700);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  /* Paragraphs */
  .recipe-content :global(p) {
    margin-bottom: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  /* Lists */
  .recipe-content :global(ul),
  .recipe-content :global(ol) {
    margin-bottom: 2rem;
    padding-left: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.75rem 2rem;
  }

  /* Single-column on mobile */
  @media (max-width: 640px) {
    .recipe-content :global(ul),
    .recipe-content :global(ol) {
      grid-template-columns: 1fr;
    }
  }

  /* List Items */
  .recipe-content :global(li) {
    position: relative;
    padding-left: 2rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    display: flex;
    align-items: flex-start;
    break-inside: avoid;
  }

  /* Checkable Ingredients (ul) */
  .recipe-content :global(ul li) {
    cursor: pointer;
  }

  .recipe-content :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 1rem;
    height: 1rem;
    border: 1.5px solid #b5bfb0;
    border-radius: 3px;
    background: transparent;
    flex-shrink: 0;
    transition: all 0.15s;
  }

  .recipe-content :global(ul li:hover::before) {
    border-color: var(--color-sage-600);
  }

  .recipe-content :global(ul li.checked) {
    text-decoration: line-through;
    opacity: 0.5;
  }

  .recipe-content :global(ul li.checked::before) {
    background: var(--color-sage-500);
    border-color: var(--color-sage-500);
  }

  /* Numbered Instructions (ol) */
  .recipe-content :global(ol) {
    counter-reset: step-counter;
    grid-template-columns: 1fr;
  }

  .recipe-content :global(ol li) {
    counter-increment: step-counter;
    cursor: default;
  }

  .recipe-content :global(ol li::before) {
    content: counter(step-counter);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.75rem;
    height: 1.75rem;
    background: var(--color-terracotta-500);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  .recipe-content :global(ol li) {
    padding-left: 3rem;
    margin-bottom: 1.5rem;
  }

  /* Strong text */
  .recipe-content :global(strong) {
    color: var(--color-charcoal-800);
    font-weight: 600;
  }

  /* Links */
  .recipe-content :global(a) {
    color: var(--color-terracotta-500);
    text-decoration: underline;
  }

  .recipe-content :global(a:hover) {
    color: var(--color-terracotta-600);
  }

  /* Print styles */
  @media print {
    .recipe-content :global(button),
    aside,
    nav {
      display: none !important;
    }
  }
</style>

<script define:vars={{ initialServings: servings }}>
  document.addEventListener('DOMContentLoaded', () => {
    // ── 1. Move recipe info card after "Ingredients" heading ──────────────
    const recipeCard = document.getElementById('recipe-info-card');
    const allH1s = Array.from(document.querySelectorAll('.recipe-content h1'));
    const ingredientsHeading = allH1s.find(
      function(h) { return h.textContent && h.textContent.toLowerCase().includes('ingredients'); }
    );

    if (recipeCard && ingredientsHeading) {
      // Style the heading so the toggle sits on the right
      ingredientsHeading.style.display = 'flex';
      ingredientsHeading.style.alignItems = 'baseline';
      ingredientsHeading.style.justifyContent = 'space-between';

      // Build US / Metric toggle
      var toggle = document.createElement('span');
      toggle.id = 'unit-toggle';
      toggle.style.cssText = 'display:inline-flex;align-items:center;gap:6px;font-size:0.875rem;font-weight:500;font-family:sans-serif;';
      toggle.innerHTML =
        '<button id="unit-us" style="background:#3a5243;color:#fff;border:none;border-radius:999px;padding:4px 14px;cursor:pointer;font-size:0.8125rem;font-weight:600;">US</button>' +
        '<button id="unit-metric" style="background:transparent;color:#6b7280;border:none;cursor:pointer;font-size:0.8125rem;font-weight:500;">Metric</button>';
      ingredientsHeading.appendChild(toggle);

      // Show the card and inject it right after the heading
      recipeCard.classList.remove('hidden');
      ingredientsHeading.after(recipeCard);
    }

    // ── 2. US / Metric toggle (visual only) ──────────────────────────────
    var usBtn = document.getElementById('unit-us');
    var metricBtn = document.getElementById('unit-metric');

    if (usBtn && metricBtn) {
      usBtn.addEventListener('click', function() {
        usBtn.style.background = '#3a5243';
        usBtn.style.color = '#fff';
        metricBtn.style.background = 'transparent';
        metricBtn.style.color = '#6b7280';
      });
      metricBtn.addEventListener('click', function() {
        metricBtn.style.background = '#3a5243';
        metricBtn.style.color = '#fff';
        usBtn.style.background = 'transparent';
        usBtn.style.color = '#6b7280';
      });
    }

    // ── 3. Serving adjuster with ingredient quantity scaling ──────────────
    var currentServings = initialServings;
    var servingCountEl = document.getElementById('serving-count');
    var decreaseBtn = document.getElementById('decrease-servings');
    var increaseBtn = document.getElementById('increase-servings');

    // Parse ingredient list items and store their original quantities
    var ingredientItems = Array.from(document.querySelectorAll('.recipe-content ul li'));
    var ingredientData = ingredientItems.map(function(item) {
      var text = (item.textContent || '').trim();
      // Match: optional leading number (decimal/fraction) + optional unit + rest
      var m = text.match(/^(\d+(?:\.\d+)?(?:\/\d+)?)\s*([a-zA-Z]+)?\s+(.+)$/);
      if (m) {
        var rawQty = m[1];
        var num = rawQty.indexOf('/') > -1
          ? parseFloat(rawQty.split('/')[0]) / parseFloat(rawQty.split('/')[1])
          : parseFloat(rawQty);
        return { element: item, quantity: num, unit: m[2] || '', ingredient: m[3], hasQuantity: true };
      }
      return { element: item, hasQuantity: false };
    });

    function toFraction(d) {
      var map = [[0.125,'1/8'],[0.25,'1/4'],[0.333,'1/3'],[0.5,'1/2'],[0.666,'2/3'],[0.75,'3/4']];
      for (var i = 0; i < map.length; i++) {
        if (Math.abs(d - map[i][0]) < 0.06) return map[i][1];
      }
      return d.toFixed(2);
    }

    function updateServings(n) {
      if (n < 1) return;
      var factor = n / initialServings;
      currentServings = n;
      if (servingCountEl) servingCountEl.textContent = String(n);

      ingredientData.forEach(function(data) {
        if (!data.hasQuantity) return;
        var scaled = data.quantity * factor;
        var display;
        if (scaled % 1 === 0) {
          display = String(scaled);
        } else if (scaled < 1) {
          display = toFraction(scaled);
        } else {
          display = scaled.toFixed(1).replace(/\.0$/, '');
        }
        data.element.textContent = (display + ' ' + data.unit + ' ' + data.ingredient).trim();
      });
    }

    if (decreaseBtn) decreaseBtn.addEventListener('click', function() { updateServings(currentServings - 1); });
    if (increaseBtn) increaseBtn.addEventListener('click', function() { updateServings(currentServings + 1); });

    // ── 4. Checkable ingredients ──────────────────────────────────────────
    ingredientItems.forEach(function(item) {
      item.addEventListener('click', function(e) {
        if (e.target && e.target.tagName === 'A') return;
        item.classList.toggle('checked');
      });
    });
  });
</script>
