---
/**
 * RecipeLayout
 * Layout template for recipe detail pages
 * Extends BaseLayout with recipe-specific structure
 * Styled exclusively with Tailwind utilities
 */
import BaseLayout from './BaseLayout.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';

export interface Props {
  title: string;
  description: string;
  image: string;
  category: string;
  prepTime: string;
  cookTime: string;
  servings: number;
  difficulty?: string;
  youtube?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  image,
  category,
  prepTime,
  cookTime,
  servings,
  difficulty,
  youtube,
  publishedTime,
  modifiedTime
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>
  <!-- Hero Image -->
  <div class="w-full h-64 md:h-96 lg:h-[28rem] relative overflow-hidden bg-gray-200">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
  </div>

  <!-- Recipe Content -->
  <article class="max-w-5xl mx-auto px-4 py-8 md:py-12">
    <!-- Header -->
    <header class="mb-8">
      <!-- Category -->
      <div class="mb-3">
        <span class="inline-block bg-orange-100 text-primary-600 px-4 py-1.5 rounded-full text-sm font-semibold uppercase tracking-wide">
          {category}
        </span>
      </div>

      <!-- Title -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-4 font-serif">
        {title}
      </h1>

      <!-- Description -->
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed max-w-3xl">
        {description}
      </p>

      <!-- Metadata -->
      <div class="flex flex-wrap items-center gap-4 md:gap-6 mt-6 text-gray-700">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div>
            <span class="text-sm text-gray-500">Prep Time</span>
            <p class="font-semibold">{prepTime}</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path>
          </svg>
          <div>
            <span class="text-sm text-gray-500">Cook Time</span>
            <p class="font-semibold">{cookTime}</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          <div>
            <span class="text-sm text-gray-500">Servings</span>
            <p class="font-semibold">{servings}</p>
          </div>
        </div>

        {difficulty && (
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <div>
              <span class="text-sm text-gray-500">Difficulty</span>
              <p class="font-semibold">{difficulty}</p>
            </div>
          </div>
        )}
      </div>

      <!-- Print Button Placeholder -->
      <div class="mt-6">
        <button
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors"
          onclick="window.print()"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
          </svg>
          Print Recipe
        </button>
      </div>
    </header>

    <!-- YouTube Video -->
    {youtube && (
      <div class="mb-8 md:mb-12">
        <YoutubeEmbed videoId={youtube} title={`${title} video`} />
      </div>
    )}

    <!-- Two-column layout: Ingredients sidebar + Instructions -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
      <!-- Ingredients Sidebar -->
      <aside class="lg:col-span-1">
        <div class="bg-orange-50 rounded-lg p-6 sticky top-24">
          <slot name="ingredients" />
        </div>
      </aside>

      <!-- Instructions and Content -->
      <div class="lg:col-span-2 recipe-content">
        <slot />
      </div>
    </div>

    <!-- Related Recipes Placeholder -->
    <section class="mt-12 md:mt-16 pt-8 border-t border-gray-200">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6">
        Related Recipes
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Placeholder for related recipes -->
        <p class="col-span-3 text-gray-500 italic">Related recipes coming soon...</p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  @reference "tailwindcss";

  /* Recipe content styling */
  .recipe-content {
    @apply text-gray-800;
  }
  
  .recipe-content h2 {
    @apply text-2xl font-bold text-gray-900 mt-8 mb-4;
  }
  
  .recipe-content h3 {
    @apply text-xl font-semibold text-gray-900 mt-6 mb-3;
  }
  
  .recipe-content ul {
    @apply list-disc list-inside space-y-2 mb-6;
  }
  
  .recipe-content ol {
    @apply list-decimal list-inside space-y-4 mb-6;
  }
  
  .recipe-content li {
    @apply text-gray-700 leading-relaxed;
  }
  
  .recipe-content p {
    @apply mb-4 leading-relaxed;
  }
  
  .recipe-content strong {
    @apply font-semibold text-gray-900;
  }

  /* Print styles */
  @media print {
    header nav,
    footer,
    button,
    .no-print {
      @apply hidden;
    }
  }
</style>
